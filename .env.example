TZ=Asia/Shanghai

# Koishi 镜像构建时使用的 npm 源。
# 国际网络默认使用官方源；国内网络可改为：https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmjs.org

# Koishi 控制台登录信息。首次部署前请修改。
KOISHI_AUTH_USERNAME=admin
KOISHI_AUTH_PASSWORD=change-me

# 机器人 QQ 号，用作 Koishi adapter-onebot selfId。
BOT_QQ=123456789

# OneBot token 可留空；如填写，Koishi 与 OneBot 实现需要保持一致。
ONEBOT_TOKEN=

# 仅使用带 LLBot 的部署方式时需要。首次部署前请修改 WebUI 密码。
LLBOT_WEBUI_TOKEN=change-me

# 仅使用带 LLBot 的部署方式时需要。默认 latest，也可以固定为具体版本。
LLBOT_TAG=latest
PMHQ_TAG=latest
LLBOT_WEBUI_PORT=3080
